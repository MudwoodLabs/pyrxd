poetry==2.5.1
# Floor for the transitive cryptography dep. Two advisories stack here:
#   <48.0.1  ships wheels with a vulnerable statically-linked OpenSSL
#            (Dependabot alert #4).
#   <50.0.0  PKCS#7 EnvelopedData decryption exposes a Bleichenbacher oracle
#            (GHSA-g6cj-pr64-35w5). Not a path pyrxd itself uses, but this pin
#            is what CI installs, so it must not resolve to a flagged version.
cryptography>=50.0.2
# Floor for the transitive virtualenv dep (Dependabot alerts #28, #29):
#   <21.7.11  writes prompt values into pyvenv.cfg without sanitising line
#             boundaries (configuration injection).
#   <21.7.12  does not integrity-check the downloaded seed wheels (pip/setuptools)
#             before use.
# CI installs this pin, so it must not resolve to a flagged version.
virtualenv>=21.15.0
# Floor for the transitive filelock dep (Dependabot alerts #37, #45, #46, #55-#60):
#   <=4.2.0  symlink, hard-link and directory-swap races in its lock files
#            (GHSA-v4x8-3wr5-3wq8, GHSA-69hj-f68j-2879 and others), patched in 4.2.1.
# filelock 4.2.0+ requires Python >= 3.11, so no patched release installs on 3.10: the floor
# applies from 3.11, and the 3.10 CI job keeps the newest filelock 3.10 can resolve.
filelock>=4.2.1; python_version >= "3.11"
